+  getWaterLevel(): number;
+  getWaterClarity(): number;
+  getFloraCount(): number;
+  getFishCount(): number;
+  getSedimentMoisture(): number; // 0.0 (arid) to 1.0 (saturated)
+  applyRainInflow(inflowRate: number, dt: number): void;
